splitter-color = darken(light-color, 3)
splitter-color-hover = darken(light-color, 10)

group-border-color = darken(light-color, 8)
group-header-color = darken(light-color, 20)

overlay()
    position fixed
    top 0
    left 0
    width 100%
    height 100%
    background-color transparent


.tab-area 
    width 100%
    height 100%

    .splitter
        background-color surface-color
        border none
        user-select none

        &:hover, &.dragging
            background-color surface-hover-color

    .split 
        width 100%
        height 100%
        display flex

        &.vertical
            flex-direction row

            &>.splitter 
                width 5px
                cursor ew-resize

        &.horizontal
            flex-direction column

            &>.splitter 
                height 5px
                cursor ns-resize

    .split-drag-overlay
        overlay()

        // Maintains the dragging mouse cursor when the pointer
        // goes slightly off the splitter element during dragging
        &.vertical
            cursor ew-resize

        &.horizontal
            cursor ns-resize

    .group 
        width 100%
        height 100%
        background-color inset-color
        border 1px solid surface-border-color

        &>.group-header
            display flex
            flex-direction row
            border-bottom 1px solid surface-border-color

            &>.tab-drop-offer
                width 3px
                background-color primary-color
                align-items stretch
                display flex 
                margin 0 -1px 0 -2px
                z-index 1
                //position relative


        &>.active-content
            width 100%
            height 100%
            background-color insert-color
        
        &>.no-active-tab 
            width 100%
            height 100%
            text-align center
            color medium-text-color
            font-weight bold
            display grid
            align-items center


.tab-header
    width min-content
    background-color inset-color
    border-right 1px solid surface-border-color
    padding 7px 10px
    display flex
    flex-direction row
    flex-wrap nowrap
    cursor pointer

    &.active-in-group 
        background-color surface-color
        border-top 1px solid primary-color

        &>.tab-close
            visibility visible

    &:hover>.tab-close
        visibility visible

    &>.tab-icon
        user-select none
        margin auto 5px auto 0
        font-weight bold
        color primary-color
        pointer-events none
        //

    &>.tab-title
        user-select none
        text-wrap nowrap
        text-overflow ellipsis
        pointer-events none
        //

    &>.tab-close
        btn-size = 16px
        user-select none
        margin auto 0 auto 7px
        font-weight bold
        color medium-text-color
        font-size 0.8em
        line-height btn-size
        width btn-size
        height btn-size
        text-align center
        border-radius border-radius
        cursor pointer
        visibility hidden

        &:hover 
            background-color surface-hover-color

    &>.tab-drag-overlay
        overlay()
        cursor grabbing 

        &>.tab-header
            cursor grabbing 
