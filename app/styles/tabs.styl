splitter-color = darken(light-color, 3)
splitter-color-hover = darken(light-color, 10)
splitter-border-color = darken(light-color, 8)

.splitter
    background-color splitter-color
    border-color splitter-border-color
    border-style solid

    &:hover
        background-color splitter-color-hover

.vsplit 
    width 100%
    height 100%
    display flex
    flex-direction row

    &>.splitter 
        width 5px
        cursor ew-resize
        border-width 0 1px

    &>.vsplit-pane 

        &.vsplit-left 
            //

        &.vsplit-right 
            //



.hsplit 
    width 100%
    height 100%
    display flex
    flex-direction column

    &>.splitter 
        height 5px
        cursor ns-resize
        border-width 1px 0

    &>.hsplit-pane 

        &.hsplit-top 
            //

        &.hsplit-bottom 
            //