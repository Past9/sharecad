bg-color(base-color, darken) 
    background-color base-color
    &:hover 
        background-color darken(base-color, darken)

.menu-bar 
    display block
    background-color darken(light-color, 5%)

    .menu-item
        bg-color(darken(light-color, 5%), 10%)
        white-space nowrap
        display inline-block
        padding 0px 10px
        box-sizing border-box
        cursor pointer
        position relative

        .submenu
            position absolute
            left 100%
            top 0px
            border-radius border-radius
            box-shadow: shadow-1
            z-index 1

        .submenu>.menu-item 
            line-height 25px
            display none

        &:hover>.submenu>.menu-item
            display block

    &>.menu-item>.submenu
        left: 0px
        top: 100%

