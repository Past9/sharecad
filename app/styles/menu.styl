menu-bg-color = darken(light-color, 5%)

bg-color(base-color, darken) 
    background-color base-color
    &:hover 
        background-color darken(base-color, darken)


.menu-item
    bg-color(menu-bg-color, 10%)
    cursor pointer
    position relative
    line-height 25px

.menu-bar 
    display block
    background-color menu-bg-color

    .menu-sep 
        display none

    &>.menu-item 
        display inline-block
        padding 0px 10px

        &:hover>.submenu 
            display block
            left 0
            top 100%


.submenu 
    position absolute
    display none
    background-color menu-bg-color
    border-radius border-radius
    box-shadow: shadow-1
    z-index 1

    &>.menu-sep 
        display block 
        background-color darken(menu-bg-color, 10%) 
        height 1px
        margin 5px 0

    &>.menu-item
        clearfix()
        bg-color(menu-bg-color, 10%)
        display block
        white-space nowrap
        box-sizing border-box
        position relative
        white-space nowrap
        padding 0px 10px
        box-sizing border-box
        position relative

        &>.menu-item-name 
            float: left
            margin-right 50px

        &>.menu-item-expandable 
            font-size 1.5em
            line-height 0.75em
            position relative
            top 5px
            width 10px
            margin-left -50px
            float: right

        &:hover>.submenu 
            display block
            left 100%
            top 0


